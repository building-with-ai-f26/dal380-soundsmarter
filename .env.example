# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# NEVER commit your actual .env file to Git!

OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key
NYRA_API_KEY=nl_live_replace-with-your-key   # CrisperWhisper speech-to-text (platform.nyra-labs.com)

# Shared online demo only (leave unset locally = open, no codes needed)
ACCESS_CODES=
TAKES_PER_CODE=0   # 0 = a code can be reused by tester after tester
DAILY_CAP=30
